extends SceneTree
var game
var ui
var passed=0
var failures=[]

func _initialize():call_deferred("run")
func check(value: bool,message: String):
	if value:passed+=1
	else:failures.append(message);printerr("FAIL "+message)

func event_touch(index: int,pos: Vector2,down: bool,canceled=false):
	var e=InputEventScreenTouch.new();e.index=index;e.position=pos;e.pressed=down;e.canceled=canceled
	Input.parse_input_event(e)
	Input.flush_buffered_events()

func check_pillar_touch():
	ui.start_practice();ui.cancel_all();game.sim.selected_character="h02C";game.sim.reset();game.rebuild_actors();game.sim.bot_enabled=false
	game.sim.players[0].pos=Vector2(-400,0);game.sim.players[1].pos=Vector2(1500,900)
	game.sim.ball=Vector3(1500,-900,0);game.update_visuals(0);ui.frame(0)
	var button=ui.buttons.ability.get_global_rect().get_center()
	event_touch(110,button,true)
	check(game.experience.overlay.target_world==game.sim.players[0].pos,"pillar touch starts with exact foot target")
	ui.touch_drag(110,button+Vector2(75,0))
	check(game.experience.overlay.target_world.distance_to(game.sim.players[0].pos)>300,"pillar drag extends placement distance")
	ui.touch_drag(110,button+Vector2(6,0))
	check(game.experience.overlay.target_world==game.sim.players[0].pos,"returning to button centre selects feet without snapping ahead")
	event_touch(110,button,false)
	check(game.sim.pending_commands.any(func(c):return c.kind=="ability" and c.target==game.sim.players[0].pos),"pillar release submits foot target")
	game.sim.advance(0.44)
	check(game.sim.arena.pillars.size()==1 and game.sim.arena.pillars[0].center==Vector2(-400,0),"native touch self cast creates pillar at the authored point")
	game.sim.selected_character="h005";ui.start_practice()

func run():
	game=load("res://main.tscn").instantiate();root.add_child(game)
	await process_frame;ui=game.touch_controls
	check(is_instance_valid(ui),"mobile adapter loaded")
	check(not quit_on_go_back,"Android Back cannot automatically terminate the scene tree")
	check(game.paused and ui.menu.visible,"initial menu pauses match")
	check(ui.movement=="stick" and ui.pick_controls.selected==1,"fresh install defaults to the left joystick")
	for dims in [Vector2i(1440,810),Vector2i(1800,810),Vector2i(1440,1080)]:
		root.size=dims;await process_frame;ui.layout();ui.frame(0)
		var viewport=Rect2(Vector2.ZERO,root.get_visible_rect().size)
		check(viewport.encloses(ui.menu.get_global_rect()),"menu fits "+str(dims))
		game.perf.layout()
		check(viewport.encloses(game.perf.panel.get_global_rect()),"performance panel fits "+str(dims))
		check(game.perf.panel.get_global_rect().end.y<ui.joystick.get_global_rect().position.y,"performance panel leaves the joystick clear "+str(dims))
		check(viewport.encloses(ui.buttons.perf_toggle.get_global_rect()) and not ui.buttons.perf_toggle.get_global_rect().intersects(ui.joystick.get_global_rect()),"performance toggle stays reachable and clear of stick "+str(dims))
		for b in [ui.pick_character,ui.pick_field,ui.pick_controls,ui.resume,ui.menu.get_node("Start")]:
			check(ui.menu.get_global_rect().encloses(b.get_global_rect()),"menu control fits "+str(dims))
	root.size=Vector2i(1440,810);await process_frame;ui.layout()
	ui.pick_character.pressed.emit();await process_frame;await process_frame
	check(ui.picker_overlay.visible and ui.picker_list.get_child_count()==18,"character picker opens with every character")
	var list_point=ui.picker_scroll.get_global_rect().get_center()
	event_touch(84,list_point,true)
	var drag=InputEventScreenDrag.new();drag.index=84;drag.position=list_point-Vector2(0,300);Input.parse_input_event(drag);Input.flush_buffered_events()
	event_touch(84,list_point-Vector2(0,300),false)
	check(ui.picker_scroll.scroll_vertical>=290 and ui.picker_overlay.visible and ui.pick_character.selected==0,"native swipe over a character scrolls without selecting it")
	ui.picker_scroll.scroll_vertical=2000;await process_frame
	check(ui.picker_scroll.scroll_vertical>500,"character list can scroll to later entries")
	var last=ui.picker_list.get_child(17).get_global_rect().get_center();event_touch(85,last,true);event_touch(85,last,false);await process_frame
	check(ui.pick_character.selected==17 and game.character_select.selected==17 and not ui.picker_overlay.visible,"last character selection updates the game and closes the list")
	ui.pick_character.pressed.emit();ui.back()
	check(game.paused and ui.menu.visible and not ui.picker_overlay.visible,"Back dismisses selection without resuming gameplay")
	ui.pick_character.select(0);ui.pick_character.item_selected.emit(0)
	ui.start_practice();ui.frame(0);game.sim.pending_commands.clear()
	check(ui.buttons.jump.visible and ui.buttons.jump.disabled,"keeper jump is visible outside own goal but unavailable")
	var jump=ui.buttons.jump.get_global_rect().get_center()
	event_touch(80,jump,true);event_touch(80,jump,false)
	check(game.sim.pending_commands.is_empty(),"unavailable jump cannot issue a stopping order")
	game.sim.players[0].pos=game.sim.arena.keeper_position(0);game.sim.holder=-1;ui.frame(0)
	check(not ui.buttons.jump.disabled,"jump becomes available for the active keeper")
	event_touch(81,jump,true);event_touch(81,jump,false);game.sim.advance(0.04);ui.frame(0)
	check(game.sim.players[0].z>0 and game.sim.players[0].keeper_cooldown>0 and ui.buttons.jump.disabled,"touching jump launches the keeper and shows cooldown")
	ui.start_practice();game.sim.take(0);game.sim.players[0].pos=game.sim.arena.keeper_position(0);ui.frame(0)
	check(ui.buttons.jump.disabled and ui.buttons.jump.text.contains("先传出球"),"holding real ball explains why jumping is blocked")
	ui.start_practice();ui.frame(0);game.sim.pending_commands.clear()
	check(not game.paused and ui.play_root.visible,"practice enters touch gameplay")
	check(ui.joystick.visible,"left joystick is visible on first play")
	check(ui.mana.get_parent()==ui.buttons.sprint and ui.mana.mouse_filter==Control.MOUSE_FILTER_IGNORE,"mana ring belongs to Sprint and cannot consume its input")
	game.sim.players[0].mana=70;game.sim.set_sprint(0,true)
	for i in range(16):game.sim.step_ball()
	ui.frame(0);var drained=ui.mana.value
	check(drained<70 and is_equal_approx(drained,game.sim.players[0].mana) and ui.mana.active,"ring follows real sprint drain and highlights the active state")
	game.sim.set_sprint(0,false)
	for i in range(16):game.sim.step_ball()
	ui.frame(0)
	check(ui.mana.value>drained and not ui.mana.active,"ring refills from real regeneration after sprint stops")
	game.sim.players[0].mana=0;ui.frame(0);check(ui.mana.value==0 and ui.mana_note.text=="0%","empty mana has no residual fill")
	game.sim.players[0].mana=100;ui.frame(0);check(ui.mana.value==100 and ui.mana_note.text=="100%","full mana fills the circle")
	check(is_instance_valid(game.perf) and game.perf.mode==0,"performance overlay defaults off for normal play")
	game.perf.end_frame({"cpu_ms":1,"sim_ms":0.2,"visual_ms":0.6,"ui_ms":0.2})
	check(not game.perf.panel.visible and game.perf.panel.mouse_filter==Control.MOUSE_FILTER_IGNORE,"hidden telemetry cannot swallow the stick or aim input")
	check(ui.tools_panel.get_rect().size.x>=626,"performance actions fit the expanded tools menu")
	check(not ui.buttons.perf_toggle.is_visible_in_tree() and not ui.buttons.benchmark.is_visible_in_tree(),"diagnostic buttons absent from clean gameplay")
	check(not ui.aim_note.visible,"idle tutorial is hidden")
	var old=ConfigFile.new();old.set_value("touch","performance",2);old.set_value("touch","clean_hud_version",5)
	game.perf.migrate_clean_hud(old)
	check(old.get_value("touch","performance")==0,"upgrade hides previously default detailed telemetry")
	old.set_value("touch","performance",1);game.perf.migrate_clean_hud(old)
	check(old.get_value("touch","performance")==1,"later explicit display choice survives restart migration")
	var more=ui.buttons.tools.get_global_rect().get_center()
	event_touch(86,more,true);event_touch(86,more,false)
	check(ui.tools_panel.visible and not ui.buttons.benchmark.is_visible_in_tree(),"More keeps diagnostics behind a second entry")
	var entry=ui.buttons.diagnostics.get_global_rect().get_center()
	event_touch(86,entry,true);event_touch(86,entry,false)
	check(ui.diagnostics_open and ui.buttons.perf_toggle.is_visible_in_tree(),"native touch opens performance tools")
	var perf_pos=ui.buttons.perf_toggle.get_global_rect().get_center()
	game.sim.pending_commands.clear()
	event_touch(86,perf_pos,true);event_touch(86,perf_pos,false);ui.frame(0)
	check(game.perf.mode==1 and game.perf.panel.visible and ui.buttons.perf_toggle.text=="隐藏性能","nested performance button opens compact view")
	event_touch(87,perf_pos,true);event_touch(87,perf_pos,false);ui.frame(0)
	check(game.perf.mode==0 and not game.perf.panel.visible and ui.buttons.perf_toggle.text=="显示性能","nested performance button hides panel")
	check(game.sim.pending_commands.is_empty() and game.experience.preferences.get_value("touch","performance")==0,"display actions save settings without leaking movement")
	ui.back();check(ui.tools_panel.visible and not ui.diagnostics_open,"Back returns to normal tools first")
	var outside=ui.buttons.kick.get_global_rect().get_center()
	event_touch(88,outside,true);event_touch(88,outside,false)
	check(not ui.tools_panel.visible and ui.aim_id==-1 and game.sim.pending_commands.is_empty(),"outside tap dismisses tools without firing underlying skill")
	for mode in [1,2]:
		game.perf.set_mode(mode);ui.frame(0);game.sim.pending_commands.clear()
		var close_pos=game.perf.close_button.get_global_rect().get_center()
		event_touch(89,close_pos,true);event_touch(89,close_pos,false)
		check(game.perf.mode==0 and not game.perf.panel.visible,"on-panel close hides performance mode "+str(mode))
		check(game.sim.pending_commands.is_empty() and ui.aim_id==-1,"closing performance does not move or shoot")
	game.sim.notice="temporary match feedback";ui.frame(0)
	check(ui.status.visible,"new feedback remains visible")
	ui.frame(3.1);check(not ui.status.visible,"stale feedback fades off the field")
	game.perf.set_mode(1);game.perf.toggle_visibility();game.perf.toggle_visibility()
	check(game.perf.mode==1 and not game.perf.graph.visible,"hide and show preserves the chosen compact view")
	game.perf.set_mode(2);ui.frame(0)
	game.perf.show_report();check(game.paused and game.perf.modal.visible,"performance report pauses gameplay")
	ui.back();check(not game.perf.modal.visible and game.paused,"Back closes performance report without resuming behind it")
	game.close_menu()
	ui.set_movement("tap")
	var field_point=Vector2(720,350)
	event_touch(0,field_point,true);event_touch(0,field_point,false)
	check(game.sim.pending_commands.size()==1 and game.sim.pending_commands[0].kind=="move","native touch creates one move")
	game.sim.pending_commands.clear()
	check(not ui.buttons.stop.visible and not ui.buttons.hold.visible,"mobile hides Stop and Hold as requested")
	var stop_pos=ui.buttons.sprint.get_global_rect().get_center()
	event_touch(1,stop_pos,true);event_touch(1,field_point,false)
	check(game.sim.pending_commands.size()==1 and game.sim.pending_commands[0].kind=="sprint","UI finger cannot leak a movement order")
	game.sim.pending_commands.clear()
	event_touch(2,field_point,true);event_touch(2,field_point,false,true)
	check(game.sim.pending_commands.is_empty(),"OS canceled touch does not move")
	game.sim.take(0);ui.frame(0)
	var kick_pos=ui.buttons.kick.get_global_rect().get_center()
	event_touch(3,kick_pos,true)
	check(game.aim=="kick" and game.sim.pending_commands.is_empty(),"holding kick begins preview without shooting")
	ui.touch_drag(3,kick_pos+Vector2(-80,-40));event_touch(3,kick_pos+Vector2(-80,-40),false)
	check(game.sim.pending_commands.size()==1 and game.sim.pending_commands[0].kind=="kick" and game.aim=="","drag aim commits once on release")
	game.sim.pending_commands.clear()
	await test_moba_controls()
	test_preaim()
	ui.set_movement("stick")
	var stick_pos=ui.joystick.get_global_rect().get_center()
	event_touch(5,stick_pos+Vector2(60,0),true);ui.frame(0.15)
	check(ui.joystick_id==5 and not game.sim.pending_commands.is_empty(),"stick sends movement")
	game.sim.pending_commands.clear()
	game.sim.players[0].cast_pending=true;ui.frame(0.2)
	check(game.sim.pending_commands.is_empty(),"held stick does not cancel turn-to-cast preparation")
	game.sim.players[0].cast_pending=false;game.sim.players[0].ability_delay=0.5;ui.frame(0.2)
	check(game.sim.pending_commands.is_empty(),"held stick does not interrupt a charged skill")
	game.sim.players[0].ability_delay=0
	event_touch(6,ui.buttons.sprint.get_global_rect().get_center(),true);event_touch(6,field_point,false)
	check(ui.joystick_id==5 and game.sim.pending_commands.size()==1 and game.sim.pending_commands[0].kind=="sprint","second finger casts without stealing stick")
	game.sim.pending_commands.clear();event_touch(5,stick_pos,false)
	check(ui.joystick_id==-1 and not game.sim.pending_commands.is_empty() and game.sim.pending_commands[0].kind=="move_release","stick release uses non-spell-canceling stop")
	game.sim.players[0].cast_pending=true;game.sim.players[0].ability_delay=0.5
	game.sim.consume_commands()
	check(game.sim.players[0].cast_pending and game.sim.players[0].ability_delay==0.5,"stick release preserves cast preparation")
	game.sim.players[0].cast_pending=false;game.sim.players[0].ability_delay=0
	ui.set_movement("tap");game.sim.pending_commands.clear()
	event_touch(7,field_point,true);event_touch(8,field_point+Vector2(200,0),true)
	ui.touch_drag(8,field_point+Vector2(250,0));event_touch(8,field_point,false);event_touch(7,field_point,false)
	check(game.sim.pending_commands.is_empty() and not game.experience.follow_camera,"two-finger camera gesture cannot send move")
	game.set_aim("kick");ui.frame(0);event_touch(10,field_point,true)
	event_touch(10,ui.buttons.cancel.get_global_rect().get_center(),false)
	check(game.sim.pending_commands.is_empty() and game.aim=="","drag onto cancel target does not kick")
	game.set_aim("kick");ui.back();check(not game.paused and game.aim=="","Back first cancels aim")
	ui.back();check(game.paused and game.menu_root.visible,"Back next opens pause menu")
	game.sim.pending_commands.clear();event_touch(9,field_point,true);event_touch(9,field_point,false)
	check(game.sim.pending_commands.is_empty(),"paused background ignores touch gameplay")
	ui.back();check(not game.paused,"Back resumes paused game")
	game._notification(Node.NOTIFICATION_WM_GO_BACK_REQUEST);check(game.paused,"native Android back notification opens menu")
	ui.back()
	game.experience.background_pause();check(game.paused,"backgrounding pauses game")
	game.close_menu()
	check(game.sim.notice!="已暂停，点继续返回比赛。","resume removes stale paused notice")
	for id in game.MatchSim.Characters.IDS:
		game.MatchSim.Characters.configure(game.sim.players[0],id);game.update_visuals(0);ui.frame(0)
		var kit=game.MatchSim.Characters.kit(game.sim.players[0])
		check(ui.buttons.secondary.visible==kit.has("secondary"),"secondary button matches "+id)
		check(ui.buttons.ability.disabled==(kit.kind=="none"),"primary availability matches "+id)
	ui.start_match();game.sim.match_state="playing";game.sim.bot_enabled=false
	ui.frame(0)
	check(ui.portrait_players.size()==3,"three allies have original portrait buttons")
	ui.set_movement("stick")
	for slot in range(3):check(ui.buttons["ally_"+str(slot)].get_node("Portrait").texture!=null,"original portrait loaded "+str(slot))
	var previous=game.sim.controlled
	game.sim.take(previous);ui.frame(0)
	event_touch(60,ui.joystick.get_global_rect().get_center()+Vector2(60,0),true)
	event_touch(61,ui.buttons.kick.get_global_rect().get_center(),true)
	var ally=ui.buttons.ally_2.get_global_rect().get_center()
	event_touch(62,ally,true);event_touch(62,ally,false)
	check(game.sim.controlled==ui.portrait_players[2],"portrait selects the exact second teammate, not nearest ball")
	check(ui.joystick_id==-1 and ui.aim_id==-1 and game.aim=="","switch clears previous player's owned touches")
	game.sim.pending_commands.clear();event_touch(61,kick_pos,false);event_touch(60,field_point,false)
	check(game.sim.pending_commands.is_empty(),"stale fingers cannot cast or move newly selected teammate")
	check(not game.sim.select_player(-1) and not game.sim.select_player(game.sim.players.size()) and not game.sim.select_player(3),"invalid and enemy portraits cannot be selected")
	ui.chosen_team=6;ui.start_match();ui.frame(0);game.perf.layout()
	for slot in range(6):
		var portrait=ui.buttons["ally_"+str(slot)].get_global_rect()
		check(is_equal_approx(portrait.position.x,ui.buttons.ally_0.get_global_rect().position.x),"portraits form a vertical column "+str(slot))
		check(not portrait.intersects(game.perf.panel.get_global_rect()) and not portrait.intersects(ui.joystick.get_global_rect()),"six teammate portraits clear performance HUD and stick "+str(slot))
	ui.chosen_team=3;ui.start_match();game.sim.match_state="playing";game.sim.bot_enabled=false
	game.sim.award_goal(0);ui.frame(0)
	check(ui.score.text.contains("1") and game.sim.audio_events[-1].kind=="goal","goal updates score and audio event")
	game.open_results();ui.frame(0)
	check(ui.report.visible and not ui.play_root.visible,"results replace gameplay UI")
	check(not ui.report_text.text.is_empty(),"mobile stats available")
	ui.start_match();game.sim.bot_enabled=false;game.sim.match_state="playing";game.sim.score_limit=1
	game.sim.award_goal(0);game._process(0)
	check(game.sim.match_state=="ended" and not ui.report.visible and not game.paused,"winning goal keeps mobile playfield visible for ball follow-through")
	game.sim.advance(4.0);game._process(0)
	check(ui.report.visible,"winning goal automatically opens mobile results after celebration")
	ui.report.get_node("Replay").pressed.emit();ui.frame(0)
	check(game.sim.match_state=="countdown" and not game.paused and not ui.report.visible,"replay restarts a fresh match")
	var result={"passed":passed,"failures":failures}
	check_pillar_touch();result={"passed":passed,"failures":failures}
	FileAccess.open("res://research/mobile-controls-test.json",FileAccess.WRITE).store_string(JSON.stringify(result,"\t"))
	print("MOBILE CHECKS ",passed," passed; ",failures.size()," failed")
	game.queue_free();await process_frame
	# Audio playback releases on the mixer thread, after the scene is freed.
	await create_timer(0.2).timeout
	quit(1 if not failures.is_empty() else 0)

func test_moba_controls():
	ui.set_movement("stick");game.sim.pending_commands.clear();game.sim.bot_enabled=false
	game.sim.take(0);ui.frame(0)
	var stick=ui.joystick.get_global_rect().get_center()+Vector2(60,0)
	var kick=ui.buttons.kick.get_global_rect().get_center()
	event_touch(40,stick,true);event_touch(41,kick,true)
	ui.touch_drag(41,kick+Vector2(-70,-20));game.sim.pending_commands.clear();ui.frame(0.15)
	var old_path=game.experience.overlay.preview.trajectory.duplicate()
	ui.touch_drag(41,kick+Vector2(-20,-70));ui.frame(0.001)
	check(game.experience.overlay.preview.trajectory!=old_path,"aim responds on the next frame without an 80 ms throttle")
	check(ui.joystick_id==40 and ui.aim_id==41,"left movement and right aim have independent owners")
	check(game.sim.pending_commands.any(func(c):return c.kind=="move_direction"),"holding shoot continues to send movement")
	var before=game.sim.players[0].pos
	for i in range(40):ui.frame(0.03);game.sim.advance(0.03)
	check(game.sim.players[0].pos.distance_to(before)>5,"player actually travels while shoot is held")
	check(game.experience.overlay.target_world.distance_to(game.sim.players[0].pos)>900,"aim target follows the moving player")
	game.sim.pending_commands.clear()
	event_touch(42,ui.buttons.ability.get_global_rect().get_center(),true)
	check(ui.aim_id==41 and game.aim=="kick","third finger cannot replace the active aiming owner")
	event_touch(42,kick,false);event_touch(41,kick+Vector2(-70,-20),false)
	check(game.sim.pending_commands.filter(func(c):return c.kind=="kick").size()==1 and game.aim=="","shoot release emits exactly one kick and clears aim")
	ui.frame(0.2)
	check(game.sim.pending_commands.any(func(c):return c.kind=="move_direction") and ui.joystick_id==40,"left stick remains live after shoot release")
	game.sim.pending_commands.clear();game.sim.take(0);ui.frame(0)
	event_touch(43,kick,true);var cancel=ui.buttons.cancel.get_global_rect().get_center()
	ui.touch_drag(43,cancel);check(ui.aim_cancelled,"cancel area highlights during drag")
	event_touch(43,cancel,false);ui.frame(0.2)
	check(not game.sim.pending_commands.any(func(c):return c.kind=="kick") and ui.joystick_id==40 and game.aim=="","cancel does not shoot or steal left stick")
	game.sim.pending_commands.clear();event_touch(44,kick,true);event_touch(44,kick,false,true)
	check(ui.aim_id==-1 and game.aim=="" and game.sim.pending_commands.is_empty(),"OS cancellation clears aim without a shot")
	event_touch(45,kick,true);event_touch(45,Vector2(-20,-20),false)
	check(ui.aim_id==-1 and game.sim.pending_commands.is_empty(),"release outside viewport cancels")
	event_touch(46,kick,true);ui.back();event_touch(46,kick,false)
	check(game.aim=="" and game.sim.pending_commands.is_empty(),"Back cancels owned aim and stale release cannot cast")
	event_touch(47,kick,true);game.open_menu();ui.frame(0);game.sim.pending_commands.clear();game.close_menu();ui.frame(0)
	event_touch(47,kick,false);event_touch(40,stick,false)
	check(ui.touches.is_empty() and game.sim.pending_commands.is_empty(),"pause flushes both touch owners without ghost commands")
	for dims in [Vector2i(1440,810),Vector2i(1800,810),Vector2i(1440,1080)]:
		root.size=dims;await process_frame;ui.layout();ui.frame(0)
		var view=Rect2(Vector2.ZERO,root.get_visible_rect().size)
		for name in ["kick","ability","secondary","sprint","hold","jump","pass","stop","cancel"]:
			check(view.encloses(ui.buttons[name].get_global_rect()),"skill control fits "+name+str(dims))
		check(not ui.buttons.kick.get_global_rect().intersects(ui.buttons.ability.get_global_rect()),"shoot and skill targets do not overlap "+str(dims))
		check(view.end.y-ui.buttons.kick.get_global_rect().end.y>=150 and view.end.x-ui.buttons.kick.get_global_rect().end.x>=100,"shoot is raised and inset from the screen edges "+str(dims))
		for name in ["kick","ability","secondary","sprint","pass"]:
			check(not ui.buttons.jump.get_global_rect().intersects(ui.buttons[name].get_global_rect().grow(12 if name=="sprint" else 0)),"jump clears skill and mana ring "+name+str(dims))
	root.size=Vector2i(1440,810);await process_frame;ui.layout()
	ui.start_practice();game.sim.take(0);ui.frame(0);game.sim.pending_commands.clear()
	game.sim.selected_character="h00F";game.sim.reset();game.sim.take(0);game.sim.Characters.use(game.sim,0,game.sim.players[0].pos+Vector2(1000,0))
	game.update_visuals(0);ui.frame(0)
	var ability=ui.buttons.ability.get_global_rect().get_center()
	event_touch(70,ability,true);event_touch(70,ability,false);game.sim.consume_commands()
	check(game.sim.players[0].ability_delay<=0,"tapping a charged skill can cancel without a visible Stop button")
	game.sim.selected_character="h005";game.sim.reset();game.sim.take(0);game.update_visuals(0);ui.frame(0)

func test_preaim():
	ui.cancel_all();ui.start_practice();game.sim.bot_enabled=false;ui.set_movement("stick")
	game.sim.holder=-1;game.sim.ball=Vector3(1200,700,0);game.sim.velocity=Vector3(25,-10,4)
	game.sim.pending_commands.clear();ui.frame(0)
	var kick=ui.buttons.kick.get_global_rect().get_center();var drag=kick+Vector2(-70,-25)
	var stick=ui.joystick.get_global_rect().get_center()+Vector2(60,0)
	check(not ui.buttons.kick.disabled,"shoot is available before catching a ball")
	event_touch(90,stick,true);event_touch(91,kick,true);ui.touch_drag(91,drag);ui.frame(0.03)
	check(ui.aim_id==91 and not game.experience.overlay.preview.trajectory.is_empty() and ui.aim_note.text.contains("预瞄"),"empty-handed hold shows a local shot indicator")
	check(ui.joystick_id==90 and game.sim.pending_commands.any(func(c):return c.kind=="move_direction"),"preaim keeps left-stick movement independent")
	var target=game.experience.overlay.target_world
	game.sim.take(0);game.sim.ball=game.sim.Copies.held_position(game.sim,0);ui.frame(0)
	check(ui.aim_id==91 and not ui.aim_note.text.contains("预瞄") and game.experience.overlay.target_world.is_equal_approx(target),"catching while held preserves preaim direction and updates hint")
	game.sim.pending_commands.clear();event_touch(91,drag,false)
	check(game.sim.pending_commands.size()==1 and game.sim.pending_commands[0].kind=="kick","catch then release submits exactly one shot immediately")
	game.sim.consume_commands()
	var aim_dir=(target-Vector2(game.sim.ball.x,game.sim.ball.y)).normalized()
	for tick in range(50):
		if game.sim.holder!=0:break
		ui.frame(game.sim.MOVE_DT);game.sim.advance(game.sim.MOVE_DT)
	check(game.sim.holder==-1 and game.sim.velocity.length()>20 and ui.joystick_id==90,"preaimed shot turns and launches while left stick stays owned")
	check(Vector2(game.sim.velocity.x,game.sim.velocity.y).normalized().dot(aim_dir)>0.999,"released ball follows the prepared direction")
	event_touch(90,stick,false);game.sim.pending_commands.clear()
	event_touch(92,kick,true);ui.touch_drag(92,drag);event_touch(92,drag,false)
	check(game.sim.pending_commands.is_empty() and ui.aim_id==-1,"release without a ball ends preview and queues no delayed shot")
	game.sim.take(0);game.sim.consume_commands()
	check(game.sim.holder==0,"catch after an empty-handed release cannot trigger a stale shot")
	event_touch(93,kick,true);game.sim.holder=1;event_touch(93,drag,false)
	check(game.sim.pending_commands.is_empty(),"losing the ball before release also prevents a shot")
	game.sim.take(0);event_touch(94,kick,true);event_touch(94,drag,false);game.sim.holder=1;game.sim.consume_commands()
	check(game.sim.holder==1,"simulation rechecks possession if ball is lost after release before command execution")
	event_touch(95,kick,true);var cancel=ui.buttons.cancel.get_global_rect().get_center();event_touch(95,cancel,false)
	check(ui.aim_id==-1 and game.sim.pending_commands.is_empty(),"empty-handed preaim still supports drag-to-cancel")
	ui.start_practice();game.sim.take(0);ui.frame(0);game.sim.pending_commands.clear()
