extends SceneTree
const Sim=preload("res://scripts/match_sim.gd")
var results=[]
var failed=false
func check(ok: bool,name: String,detail=""):
	results.append({"test":name,"passed":ok,"detail":detail})
	failed=failed or not ok
	print(("PASS " if ok else "FAIL ")+name+" "+str(detail))
func _initialize():call_deferred("run")
func scene(id: String):
	var s=Sim.new();s.selected_character=id;s.reset()
	s.players[0].pos=Vector2(-600,0)
	s.players[1].pos=Vector2(1700,900)
	s.ball=Vector3(1400,-800,0)
	return s
func run():
	var s=scene("h02C")
	s.Characters.use(s,0,Vector2.ZERO)
	s.advance(0.39)
	check(s.arena.pillars.is_empty(),"pillar waits for the original creation delay")
	s.advance(0.04)
	check(s.arena.pillars.size()==1 and not s.arena.point_free(Vector2.ZERO,30),"pillar birth adds a real circular obstruction")
	s.command(0,Vector2(600,0))
	check(s.players[0].path.size()>1,"route detours around a newly spawned pillar")
	var clear=true
	for i in range(40):
		s.advance(0.05)
		clear=clear and s.players[0].pos.length()>=89.9
	check(clear,"walking respects the combined player and pillar radius")
	s.advance(3)
	check(s.arena.pillars.is_empty() and s.arena.point_free(Vector2.ZERO,30) and s.players[0].pos.distance_to(Vector2(600,0))<20,"pillar expiry restores passage and move order completes")
	s=scene("h02C")
	s.players[0].pos=Vector2.ZERO
	s.Characters.use(s,0,Vector2(500,500))
	check(s.players[0].ability_target==Vector2(350,350),"pillar placement uses original Manhattan-distance clamp")
	s=scene("h02C")
	s.players[1].pos=Vector2.ZERO
	s.Characters.use(s,0,Vector2.ZERO);s.advance(0.44)
	check(s.players[1].z>0 and s.arena.pillars[0].knocked_units.has(1),"pillar creation launches an occupying player")
	s=scene("h02C");s.ball=Vector3.ZERO
	s.Characters.use(s,0,Vector2.ZERO);s.advance(0.44)
	check(s.ball.z>0 and s.velocity.z>0 and s.arena.pillars[0].ball_knocked,"pillar creation launches a free ball without immediately reflecting it")
	s=scene("h005")
	s.arena.add_pillar(Vector2.ZERO,0)
	s.ball=Vector3(-200,0,50);s.velocity=Vector3(80,0,0)
	s.travel_ball(Vector3(500,0,0))
	check(s.velocity.distance_to(Vector3(-72,0,0))<0.001 and s.ball.x<-90,"high-speed ball reflects off pillar with ninety-percent speed")
	check(s.arena.sweep_ball(Vector3(-200,0,301),Vector3(500,0,0)).is_empty(),"ball above three hundred clears the pillar")
	s.players[0].pos=Vector2(-200,0);s.players[0].knock=Vector2(80,0)
	s.step_object_impulses();s.step_object_impulses()
	check(s.players[0].knock.x<0 and s.players[0].pos.x<=-90,"player impulse rebounds from pillar")
	s=scene("h00F");s.take(0);s.step_ball()
	s.Characters.use(s,0,Vector2(1800,0))
	s.advance(0.25)
	check(s.holder==0 and not s.powershot_active and s.players[0].pos==Vector2(-600,0),"powershot charges without moving or releasing early")
	s.command(0,Vector2(800,0));s.advance(0.27)
	check(s.powershot_active and s.holder==-1 and s.velocity.x>50 and s.velocity.z==0 and s.players[0].cooldown==0,"right-click preserves charge and completed shot clears cooldown")
	var speed=s.velocity.length();s.step_ball()
	check(absf(speed-s.velocity.length()-0.02)<0.001,"powershot uses original low friction rather than zero friction")
	s.ball=Vector3(0,1280,20);s.velocity=Vector3(0,50,0)
	s.travel_ball(Vector3(0,100,0))
	check(s.velocity.y<0 and absf(s.velocity.length()-50)<0.001,"powershot wall rebound has no fixed four-unit loss")
	s.players[1].pos=Vector2(800,500)
	s.ball=Vector3(550,500,0);s.velocity=Vector3(51,0,0)
	s.travel_ball(Vector3(400,0,0))
	check(s.holder==1 and not s.powershot_active and absf(s.players[1].knock.x-43.35)<0.001,"catching powershot applies eighty-five-percent impact and restores normal ball mode")
	s=scene("h00F");s.take(0);s.step_ball()
	s.Characters.use(s,0,Vector2(1800,0));s.advance(0.1);s.stop(0);s.advance(0.5)
	check(s.holder==0 and not s.powershot_active and s.players[0].cooldown>5,"stop cancels powershot but retains interrupted cooldown")
	s=scene("h00F");s.take(0);s.step_ball()
	s.Characters.use(s,0,Vector2(1800,0));s.take(1);s.advance(0.6)
	check(not s.powershot_active and s.players[0].ability_delay<=0,"losing possession cancels charging")
	s=scene("h026")
	s.players[0].pos=Vector2.ZERO;s.players[1].pos=Vector2(150,0)
	s.Characters.use(s,0,Vector2.ZERO);s.advance(0.1)
	check(s.players[1].pos==Vector2(150,0),"smash has its own short windup")
	s.advance(0.08)
	check(s.players[1].pos.x>150 and s.players[1].ogre_slow>0,"smash pushes and slows a frontal enemy")
	s=scene("h026");s.players[0].pos=Vector2.ZERO;s.players[1].pos=Vector2(150,0);s.players[1].team=0
	s.Characters.smash(s,0)
	check(s.players[1].knock==Vector2(45,0) and s.players[1].ogre_slow==0,"smash also pushes allies without the enemy slow")
	s.players[1].knock=Vector2.ZERO;s.players[1].pos=Vector2(-100,0)
	s.Characters.smash(s,0)
	check(s.players[1].knock==Vector2.ZERO,"smash does not hit behind the caster")
	s.ball=Vector3(500,0,0);s.velocity=Vector3(1,2,3);s.last_owner=0
	s.Characters.smash(s,0)
	check(s.velocity==Vector3(55,0,0),"smash replaces own recently kicked ball velocity out to seven hundred")
	s=scene("h026");s.players[0].pos=Vector2.ZERO;s.players[1].pos=Vector2(150,0)
	s.arena.add_box(Rect2(200,-200,20,400),240)
	s.Characters.use(s,0,Vector2.ZERO);s.advance(0.3)
	check(s.players[1].stun>1 and s.players[1].ogre_slow==0 and s.players[1].knock==Vector2.ZERO,"smashed enemy hitting a wall stops and is stunned")
	s=scene("h026")
	s.toggle_sprint(0);s.advance(1)
	check(absf(s.players[0].mana-60)<0.001 and s.players[0].sprint_cooldown>6,"ogre sprint consumes forty net mana and starts cooldown")
	s.toggle_sprint(0);s.toggle_sprint(0)
	check(not s.players[0].sprint,"ogre sprint cannot bypass its restart cooldown")
	s=scene("h02C");s.Characters.use(s,0,Vector2.ZERO);s.advance(0.5);s.powershot_active=true;s.reset()
	check(s.arena.pillars.is_empty() and not s.powershot_active,"reset removes all temporary obstruction and special ball state")
	var f=FileAccess.open("res://research/advanced-skills-tests.json",FileAccess.WRITE)
	f.store_string(JSON.stringify({"checks":results},"\t"))
	quit(1 if failed else 0)
