extends SceneTree
const Sim=preload("res://scripts/match_sim.gd")
const Report=preload("res://scripts/match_report.gd")
var results=[]
var failed=false
func check(ok: bool,name: String,detail=""):
	results.append({"test":name,"passed":ok,"detail":detail})
	failed=failed or not ok
	print(("PASS " if ok else "FAIL ")+name+" "+str(detail))
func _initialize():call_deferred("run")
func live(s):
	s.bot_enabled=false;s.countdown=0;s.step_ball()
func run():
	var s=Sim.new()
	s.start_match()
	check(s.mode=="score" and s.score_limit==10 and s.duration==0,"default original match is ten goals without timer")
	live(s)
	check(s.velocity.z==0 and s.velocity.length()>=15 and s.velocity.length()<=20 and s.ball==Vector3.ZERO,"kickoff injects original 15-20 horizontal impulse")
	check(not s.choose_halftime_character("h003"),"hero changes are restricted to halftime")
	s.time_left=0;s.step_ball()
	check(s.match_state=="playing" and not s.overtime,"score mode never ends due to clock")
	s.score=[9,9];s.last_owner=0;s.award_goal(1)
	check(s.winner==1 and s.match_state=="ended" and s.score==[9,10],"tenth goal decides score match even when one goal ahead")
	s.award_goal(0)
	check(s.score==[9,10] and s.goal_history.size()==1,"late goal callback cannot change a finished match")
	s.start_match(3,10,20);live(s)
	check(s.mode=="timed" and s.score_limit==0,"timed mode disables score target")
	s.score=[10,0];s.last_owner=0;s.award_goal(0)
	check(s.match_state=="goal" and s.winner==-1,"timed match can exceed ten goals")
	var remaining=s.time_left;s.advance(3.9)
	check(s.match_state=="goal" and s.time_left==remaining,"default celebration is four seconds with clock paused")
	s.advance(0.15)
	check(s.match_state=="countdown" and s.countdown>2.9,"celebration leads to three-second countdown")
	s.advance(2.9)
	check(s.match_state=="countdown" and s.time_left==remaining,"clock remains paused throughout kickoff countdown")
	s.advance(0.15)
	check(s.match_state=="playing" and s.time_left<remaining and s.time_left>remaining-0.1,"clock resumes only after kickoff")
	s.score=[2,2];s.time_left=0.001;s.step_ball()
	check(s.overtime and s.time_left==120 and s.extra_period==1,"timed tie starts a full two-minute extension")
	s.last_owner=0;s.award_goal(0)
	check(s.match_state=="goal" and s.winner==-1,"leading goal during extension is not sudden death")
	s.advance(7.1);s.time_left=0.001;s.step_ball()
	check(s.match_state=="ended" and s.winner==0,"extension ends with winner only when its timer expires")
	s.start_match(3,10,30);live(s);s.time_left=0.001;s.step_ball()
	s.time_left=0.001;s.step_ball()
	check(s.extra_period==2 and s.time_left==120 and s.match_state=="playing","repeated tie grants another full extension")
	# Original six-second assist chain: real kicks, team changes and expirations.
	s.start_match(3);live(s)
	s.take(0);s.kick(0,Vector2(1000,0));s.take(1);s.kick(1,Vector2(1000,0));s.take(2);s.kick(2,Vector2(1000,0));s.award_goal(0)
	check(s.stats[2].goals==1 and s.stats[0].assists==1 and s.stats[1].assists==1,"multiple same-team passers earn assists while scorer is excluded")
	check(s.goal_history[0].scorer==2 and s.goal_history[0].assists==[0,1] and s.goal_history[0].score==[1,0],"goal record retains scorer assistants and score snapshot")
	s.controlled=1;s.advance(7.1)
	check(s.controlled==1 and s.stats[0].assists==1 and s.assistants.is_empty(),"round reset retains player selection and statistics but clears assist chain")
	s.take(0);s.kick(0,Vector2(1000,0));s.time+=6;s.take(1);s.award_goal(0)
	check(s.stats[0].assists==1 and s.goal_history[1].assists.is_empty(),"assist expires at six seconds")
	s.advance(7.1);s.take(0);s.kick(0,Vector2(1000,0));s.take(3);s.take(1);s.award_goal(0)
	check(s.goal_history[-1].assists.is_empty(),"opponent possession clears the previous pass chain")
	s.advance(7.1);s.take(1);s.kick(1,Vector2(1000,0));s.take(0);s.award_goal(1)
	check(s.stats[0].own_goals==1 and s.stats[0].goals==0 and s.goal_history[-1].own_goal and s.goal_history[-1].assists.is_empty(),"own goal has separate tally and gives no assists")
	var text=Report.history_text(s)
	check("助攻 蓝1号、蓝2号" in text and "乌龙" in text and "进球 / 助攻 / 乌龙" in Report.team_text(s,0),"report presents scorer assists and own goals")
	s.start_match(3);live(s)
	s.players[1].pos=Vector2(-400,0);Sim.Characters.configure(s.players[1],"h003")
	s.ball=Vector3(0,0,50);s.velocity=Vector3(10,0,0);s.last_owner=0
	Sim.Characters.use(s,1,Vector2.ZERO);Sim.Characters.step(s)
	check(s.last_owner==0 and s.assistants.has(1),"black hole assists the allied owner without immediately stealing moving-ball attribution")
	s.ball=Vector3(900,0,50);s.velocity=Vector3(-10,0,0);Sim.Characters.step(s)
	check(s.last_owner==1 and s.assistants.has(0),"black hole redirects attribution after ball exits with over eighty degrees of turn")
	s.ball=Vector3(0,0,50);s.velocity=Vector3.ZERO;s.last_owner=-1;Sim.Characters.step(s)
	check(s.last_owner==1,"black hole claims an ownerless stationary ball")
	s.start_match(3,10,0,true);live(s);s.half=2;s.score=[1,1];s.time_left=0.001;s.step_ball()
	check(s.match_state=="playing" and s.overtime and s.time_left==120,"tied second half enters extension instead of another halftime")
	# Field ownership must move as a whole: scoring, paths, AI and goalkeepers.
	for field in range(4):
		s=Sim.new();s.selected_field=field;s.start_match(3,10,0,true);live(s)
		s.controlled=1;s.score=[2,1];s.stats[1].goals=2
		s.time_left=0.001;s.step_ball()
		check(s.mode=="tournament" and s.half==2 and s.match_state=="halftime" and s.winner==-1,"field %d first half ends without declaring a winner"%field)
		var held: Vector2=s.players[1].pos
		s.submit_command("move",1,Vector2(1000,0));s.advance(2.9)
		check(s.players[1].pos==held and not s.arena.sides_swapped,"field %d halftime locks input before the three-second swap"%field)
		s.advance(0.15)
		check(s.arena.sides_swapped and s.players[0].pos.x>0 and s.players[3].pos.x<0 and is_equal_approx(s.players[0].body,PI),"field %d swaps player positions and facing"%field)
		check(s.arena.keeper_position(0).x>0 and s.arena.shot_target(0).x<0 and s.arena.in_guard(s.players[2].pos,0),"field %d keeper and target follow new team ends"%field)
		check(s.goal_restrictions(0).has(s.arena.guards[1][0]) and not s.free_point(s.players[5].pos,0),"field %d opposing goal restrictions follow the swapped team"%field)
		check(s.choose_halftime_character("h003") and s.roster[1]=="h003","field %d halftime selection changes controlled participant"%field)
		s.advance(12)
		check(s.match_state=="countdown" and s.time_left==600 and s.score==[2,1] and s.controlled==1 and s.players[1].character=="h003" and s.stats[1].goals==2,"field %d second half keeps score identity hero and statistics"%field)
		s.advance(3.0)
		check(s.match_state=="playing" and s.time_left>599.8,"field %d second half starts after three-second countdown"%field)
		for i in range(s.players.size()):s.players[i].pos=Vector2(-1000+i*220,-1000);s.stop(i)
		s.controlled=0;s.players[1].pos=Vector2(-1500-(s.arena.half_size.x-2016),100);s.take(1);s.step_ball();Sim.TeamAI.think(s)
		check(s.holder<0 and s.velocity.x<0,"field %d blue AI shoots left after halftime"%field)
		for i in range(s.players.size()):s.stop(i)
		s.advance(1.5)
		check(s.score==[3,1] and s.match_state=="goal" and s.goal_history[-1].half==2,"field %d actual left goal credits blue in second half"%field)
		s.advance(7.1);s.time_left=0.001;s.step_ball()
		check(s.match_state=="ended" and s.winner==0,"field %d second-half horn declares aggregate winner"%field)
		s.start_match(3)
		check(not s.arena.sides_swapped and s.arena.keeper_position(0).x<0 and s.score==[0,0] and s.goal_history.is_empty() and s.stats[1].goals==0,"field %d restart clears statistics and restores first-half ends"%field)
	var file=FileAccess.open("res://research/match-modes-tests.json",FileAccess.WRITE)
	file.store_string(JSON.stringify({"checks":results},"\t"));quit(1 if failed else 0)
