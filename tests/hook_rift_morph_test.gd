extends SceneTree
const Sim=preload("res://scripts/match_sim.gd")
var results=[]
var failed=false
func check(ok: bool,name: String,detail=""):
	results.append({"test":name,"passed":ok,"detail":str(detail)})
	failed=failed or not ok
	print(("PASS " if ok else "FAIL ")+name+" "+str(detail))
func _initialize():call_deferred("run")
func scene(id: String):
	var s=Sim.new();s.selected_character=id;s.reset()
	s.players[0].pos=Vector2(-600,0);s.players[1].pos=Vector2(1700,900)
	s.ball=Vector3(1400,-900,0)
	return s
func pair():
	var s=scene("h027")
	s.Characters.use(s,0,Vector2(0,0));s.advance(1.51)
	s.Characters.use(s,0,Vector2(-600,-600));s.advance(0.8)
	return s
func borrow(id: String):
	var s=scene("h029");s.players[0].morph_kit=id;s.players[0].morph_casts=3
	return s
func run():
	var s=scene("h01R")
	s.Characters.use(s,0,Vector2(900,0));s.advance(0.25)
	check(s.projectiles.size()==1 and s.projectiles[0].pos.distance_to(Vector3(-260,0,0))<0.001,"hook travels forty units per 32 Hz update",s.projectiles[0].pos)
	check(s.players[0].cooldown>25.7 and s.players[0].secondary_cooldown==0,"enemy and ally hooks have independent cooldowns")
	check(not s.Characters.use(s,0,Vector2(900,0),true),"other hook mode cannot replace an in-flight hook")
	s.Characters.use(s,0,Vector2.ZERO);s.advance(0.4)
	check(s.projectiles.is_empty() and s.players[0].hook.is_empty(),"early withdrawal returns and removes hook state")
	check(s.Characters.use(s,0,Vector2(900,0),true) and s.players[0].secondary_cooldown==22,"ally hook remains usable during enemy cooldown")
	s=scene("h01R");s.players[1].pos=Vector2(-150,0)
	s.Characters.use(s,0,Vector2(900,0));s.advance(0.4)
	check(s.players[1].hooked!=0 and s.players[1].pos.x< -150,"enemy contact reels target toward caster")
	check(s.players[1].silence>0 and not s.Characters.use(s,1,Vector2.ZERO),"hooked enemy cannot cast skills")
	var before=s.players[1].pos
	s.Characters.use(s,0,Vector2.ZERO);s.advance(0.2)
	check(s.players[1].hooked==0 and s.players[1].pos==before and s.players[1].silence>0,"second Q drops target in place with half-second silence tail")
	s.advance(0.4)
	check(s.players[1].silence==0,"released enemy regains spell control")
	s=scene("h01R");s.players[1].team=0;s.players[1].pos=Vector2(-150,0)
	s.Characters.use(s,0,Vector2(900,0));s.advance(0.5)
	check(s.players[1].hooked==0 and s.players[1].pos==Vector2(-150,0),"enemy hook ignores allied players")
	s=scene("h01R");s.players[1].team=0;s.players[1].pos=Vector2(-150,0)
	s.Characters.use(s,0,Vector2(900,0),true);s.advance(0.4)
	check(s.players[1].hooked!=0 and s.players[1].silence==0,"ally hook pulls without silencing")
	s.advance(1.4)
	check(s.players[1].hooked==0 and s.projectiles.is_empty() and s.players[1].pos.distance_to(s.players[0].pos)<130 and s.free_point(s.players[1].pos,1),"full player reel restores collision at a legal nonoverlapping position")
	before=s.players[1].pos;s.command(1,before+Vector2(0,400));s.advance(1.2)
	check(s.players[1].pos.distance_to(before)>100,"fully reeled player can move normally after release")
	s=scene("h01R");s.ball=Vector3(-100,0,0)
	s.Characters.use(s,0,Vector2(900,0));s.advance(0.4)
	check(s.ball_hook!=0 and s.holder==-1,"hook captures free scoring ball without normal flight competing")
	s.advance(1)
	check(s.ball_hook==0 and s.holder==0 and s.projectiles.is_empty(),"returning ball becomes available to caster for normal possession")
	s=scene("h01R");s.players[1].pos=Vector2(-100,0);s.players[1].body=PI
	s.take(1);s.step_ball();s.Characters.use(s,0,Vector2(900,0));s.advance(0.4)
	check(s.holder==-1 and s.ball_hook!=0,"enemy hook can take the opposing held real ball")
	s=scene("h01R");s.players[1].pos=Vector2(-150,0);s.players[1].z=400
	s.Characters.use(s,0,Vector2(900,0));s.Characters.Complex.hook_step(s,s.projectiles[0])
	check(s.Characters.Complex.hook_candidate(s,s.projectiles[0],Vector3(-250,0,0),Vector3(40,0,0)).is_empty(),"hook respects target height")
	s=scene("h01R");s.players[1].pos=Vector2(-150,0);s.arena.add_box(Rect2(-300,-180,25,360),240)
	s.Characters.use(s,0,Vector2(900,0));s.advance(0.8)
	check(s.players[1].hooked==0 and s.players[1].pos.x==-150,"wall prevents hook contact through its proximity radius")
	s=scene("h01R");s.players[1].pos=Vector2(-150,0)
	s.Characters.use(s,0,Vector2(900,0));s.advance(0.4)
	s.arena.add_box(Rect2(-480,-180,25,360),240);s.advance(0.7)
	check(s.players[1].hooked==0 and s.players[1].pos.x>=-425.1,"wall appearing during reel releases target before solid terrain",s.players[1].pos)
	s.advance(8.6)
	check(s.projectiles.is_empty() and s.players[0].hook.is_empty(),"blocked hook failsafe expires without leaving stale control")
	s=scene("h027");s.Characters.use(s,0,Vector2(0,0))
	check(not s.Characters.use(s,0,Vector2(-600,-600)),"rift cannot launch second projectile before unlock")
	s.advance(1.51)
	check(s.rifts.size()==1 and s.rifts[0].a!=null and s.rifts[0].b==null and s.Characters.q_available(s.players[0]),"first landing opens entry and second cast unlocks at 1.5 seconds")
	s.Characters.use(s,0,Vector2(-600,-600));s.advance(0.8)
	check(s.rifts.size()==1 and s.rifts[0].b!=null and s.players[0].cooldown>31,"second landing creates paired portals and starts 32-second cooldown")
	var r=s.rifts[0]
	s.players[1].pos=Vector2(r.a.x,r.a.y);s.players[1].knock=Vector2.ZERO;s.players[1].z=0
	s.Characters.Complex.step(s)
	check(s.players[1].pos.distance_to(Vector2(r.b.x,r.b.y))<0.001 and r.traveled.has(1) and s.players[1].knock.length()>12,"enemy player teleports and receives exit impulse")
	var destination=s.players[1].pos;s.Characters.Complex.step(s)
	check(s.players[1].pos==destination,"each player travels only once per portal pair, preventing ping-pong")
	s=pair();r=s.rifts[0];s.ball=r.a;s.velocity=Vector3(8,0,0)
	s.Characters.Complex.step(s)
	check(s.ball==r.b and absf(s.velocity.x-11.125)<0.001 and r.traveled.has(-2),"free ground ball transfers with original moving-ball impulse")
	s=pair();r=s.rifts[0];s.ball=r.a+Vector3(0,0,50);s.players[1].pos=Vector2(r.a.x,r.a.y);s.players[1].z=40
	s.Characters.Complex.step(s)
	check(not r.traveled.has(-2) and not r.traveled.has(1),"airborne ball and players above 25 do not enter portal")
	s=pair();r=s.rifts[0];s.players[1].pos=Vector2(r.a.x,r.a.y);s.take(1)
	s.Characters.Complex.step(s)
	check(s.holder==1 and Vector2(s.ball.x,s.ball.y).distance_to(s.players[1].pos)<=100.01,"carried ball follows a teleported player without becoming a separate traveler")
	s=pair();r=s.rifts[0]
	s.Characters.Complex.rift_teleport(s,r,0,Vector3(2090,0,0))
	check(not s.arena.in_guard(s.players[0].pos,1),"rift cannot place attacker in protected opposing goal")
	s=pair();s.advance(3.2)
	check(s.rifts.is_empty() and s.players[0].rift.is_empty() and s.players[0].cooldown>27,"paired portals expire after three seconds and preserve cooldown")
	s=scene("h027");s.Characters.use(s,0,Vector2.ZERO);s.advance(6.0)
	check(s.rifts.is_empty() and s.players[0].cooldown>8 and s.players[0].cooldown<=10,"unused entry times out with ten-second refund cooldown")
	s=scene("h029");s.Characters.use(s,0,Vector2.ZERO);s.command(0,Vector2(500,0));s.advance(2.4)
	check(s.players[0].pos==Vector2(-600,0) and s.players[0].morph_kit=="","random mutation channel prevents movement for 2.5 seconds")
	s.advance(0.15)
	check(s.players[0].morph_casts==3 and s.Characters.Morph.POOL.has(s.players[0].morph_kit) and s.players[0].speed==300 and s.players[0].catch_height==140,"mutation grants three borrowed casts while preserving base attributes")
	var last=s.players[0].morph_kit
	s.submit_command("morph_reset",0);s.advance(0.04)
	check(s.players[0].morph_kit=="" and s.players[0].cooldown>19.9,"F1 command abandons idle borrowed kit with twenty-second cooldown")
	s.advance(20.1);s.Characters.use(s,0,Vector2.ZERO);s.advance(2.6)
	check(s.players[0].morph_kit!=last,"next random selection excludes the previous borrowed character")
	s=borrow("h012")
	check(not s.Characters.use(s,0,Vector2(500,0)) and s.players[0].morph_casts==3,"failed possession requirement does not consume borrowed charges")
	for n in range(3):
		s.players[0].cooldown=0;s.take(0);s.step_ball();s.Characters.use(s,0,Vector2(500,100),n%2==1)
	check(s.players[0].morph_casts==0 and s.players[0].morph_ghost>0 and not s.Characters.q_available(s.players[0]),"Q and R borrow the same three-use budget, with no fourth cast")
	s.advance(3.6)
	check(s.players[0].morph_kit=="" and s.players[0].cooldown>19,"last borrowed spell finishes before mutation cooldown begins")
	s=borrow("h00Y");s.Characters.use(s,0,Vector2.ZERO);s.Characters.use(s,0,Vector2.ZERO)
	check(s.players[0].morph_casts==2 and s.players[0].pull_time==0,"canceling borrowed pull does not consume a second charge")
	s=borrow("h005");s.players[0].angle=PI;s.Characters.use(s,0,Vector2(800,0))
	check(s.players[0].morph_casts==3,"borrowed tackle consumes charge on actual cast, not turn preparation")
	s.stop(0);s.advance(0.5)
	check(s.players[0].morph_casts==3,"canceling tackle preparation keeps borrowed charge")
	s=borrow("h01R");s.Characters.use(s,0,Vector2(800,0));s.Characters.use(s,0,Vector2.ZERO)
	check(s.players[0].morph_casts==2,"borrowed hook withdrawal does not consume another charge")
	s=borrow("h003");s.Characters.use(s,0,Vector2(1800,0))
	check(s.players[0].morph_casts==3 and not s.players[0].ability_order.is_empty(),"walking into cast range does not spend a borrowed charge early")
	s.advance(8)
	check(s.players[0].morph_casts==2,"range approach spends exactly one charge when spell fires")
	for id in ["h01R","h027","h029"]:
		s=scene(id);s.mixed_roster=true;s.start_match(6);s.advance(24)
		var valid=true
		for p in s.players:valid=valid and p.pos.is_finite() and is_finite(p.z)
		check(valid and s.ball.is_finite(),"twelve-player mixed match remains finite with "+id)
	s.reset()
	check(s.rifts.is_empty() and s.projectiles.is_empty() and s.ball_hook==0 and s.players.all(func(p):return p.hooked==0 and p.silence==0 and p.morph_kit==""),"new round clears portals, hooks, silence and borrowed skills")
	var out=FileAccess.open("res://research/hook-rift-morph-tests.json",FileAccess.WRITE)
	out.store_string(JSON.stringify(results,"\t"));out.close()
	quit(1 if failed else 0)
